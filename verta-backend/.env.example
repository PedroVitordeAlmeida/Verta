# Renomeie para .env e ajuste os valores conforme o ambiente do docker-compose.
# Estas variaveis sao lidas em src/main/resources/application.conf

# Banco de dados PostgreSQL (mesmo banco ja criado com as tabelas do projeto Verta)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=verta
DB_USER=verta_user
DB_PASSWORD=troque_esta_senha

# Autenticacao JWT
JWT_SECRET=troque_este_segredo_por_um_valor_aleatorio_grande
JWT_ISSUER=verta-backend
JWT_AUDIENCE=verta-app
JWT_REALM=verta-app

# Porta em que o Ktor vai escutar dentro do container
PORT=8080

# Origem(ns) permitidas para CORS (o front em React/Figma-to-code, por ex.)
CORS_ALLOWED_HOST=frontend:3000
